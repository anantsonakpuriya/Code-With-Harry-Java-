public class JavaPracticeSet6Que5 {
    public static void main(String[] args) {
        int[]arr={1,2,3,4,5};
        int j=(arr.length-1);
        int temp;
        for(int i=0;i<=j;i++){
            temp=arr[i];
             arr[i]=arr[j-i];
             arr[j-i]=temp;
             if(arr[i]==arr[j-i]){
                 break;
             }
        }
        for(int i=0;i<arr.length;i++){
            System.out.print(arr[i]);
        }
        System.out.println();
        //using while loop
        int a=0;
        while(arr[a]!=arr[j-a]){
             temp=arr[a];
             arr[a]=arr[j-a];
             arr[j-a]=temp;
             a++;
        }
       for(int i=0;i<arr.length;i++){
            System.out.print(arr[i]);
        }
    }
}
