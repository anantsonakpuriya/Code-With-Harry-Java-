import java.util.Scanner;
public class JavaPracticeSet7Que6 {
    static float avg(float...arr){
       float sum=0;
       for(float a:arr){
           sum+=a;
       }
       float average=(float)sum/arr.length;
       return average;
    }
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        System.out.println("Enter the total no. of numbers:");
        int n=sc.nextInt();
        float arr[]=new float[n];
        for(int i=0;i<n;i++){
            System.out.println("Enter the "+(i+1)+" term:");
            arr[i]=sc.nextFloat();
        }
        float average=avg(arr);
        System.out.println("Average:"+average);
    }
}
