import java.util.Scanner;
public class JavaPracticeSet5Que11 {
    public static void main(String[] args) {
        Scanner sc= new Scanner(System.in);
        System.out.println("Enter the quantity of first even numbers to be added:");
        int n=sc.nextInt();
        int sum=0;
        int even;
        for(int i=0;i<n;i++){
            even=2*i;
            sum=sum+even;
        }
        System.out.println(sum);
    }
}
